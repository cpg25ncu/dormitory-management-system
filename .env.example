# Generate distinct passwords for the database and first administrator.
DORM_DB_PASSWORD=
DORM_ADMIN_USERNAME=admin
DORM_ADMIN_PASSWORD=
DORM_PORT=8080
DORM_SECURE_COOKIE=false
# Set to native when a trusted reverse proxy sets X-Forwarded-For.
DORM_FORWARD_HEADERS=none
# IANA time zone of the residence, for example Asia/Shanghai or Europe/London.
DORM_TIME_ZONE=UTC
